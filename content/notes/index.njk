---
layout: layouts/base.njk
title: Notes
description: Short dispatches from Shira's corner of the Fediverse.
permalink: /notes/index.html
---
<section class="hero compact-hero"><div class="hero-content">
  <h1 class="site-headline">FediverseNotes</h1>
  <p class="site-description">Short public posts imported from @jewitch@social.lol.</p>
  <div class="hero-badge"><a class="activitypub-badge" href="https://social.lol/@jewitch" rel="me external">@follow ActivityPub</a></div>
</div></section>
<div class="content-wrapper">
  <main class="posts-container">
  {% for note in collections.notes %}
  <article class="post-card"><div class="post-card-content">
    <div class="post-meta"><time datetime="{{ note.data.mastodon_created_at }}">{{ note.date | readableDate }}</time></div>
    <div class="post-excerpt fediverse-content">{{ note.content | safe }}</div>
    <div class="card-actions"><a href="{{ note.url }}" class="read-more">permalink()</a><a href="{{ note.data.source_url }}" class="read-more">conversation() →</a></div>
  </div></article>
  {% endfor %}
  </main>
  <aside class="sidebar">
    <div class="activitypub-card"><h3>Federated Content</h3><p>Original public posts sync automatically. Replies and boosts remain on Mastodon.</p><a href="https://social.lol/@jewitch" class="activitypub-link" rel="me external">Follow Shira</a></div>
  </aside>
</div>
