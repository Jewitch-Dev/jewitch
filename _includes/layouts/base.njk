<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.name %}{{ title }} - {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if page.filePathStem.startsWith('/posts/') or page.filePathStem.startsWith('/notes/imported/') %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta name="twitter:card" content="summary">
  <meta name="fediverse:creator" content="{{ site.fediverse }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="visually-hidden" rel="me" href="https://social.lol/@jewitch">Mastodon</a>
  <header class="site-header"><div class="container"><div class="header-content">
    <h1 class="site-title"><a href="/">Jewitch</a></h1>
    <nav class="main-nav" aria-label="Main navigation"><ul>
      <li><a href="/">Home</a></li><li><a href="/blog/">Blog</a></li><li><a href="/notes/">Notes</a></li><li><a href="/now/">Now</a></li><li><a href="/about/">About</a></li>
    </ul></nav>
  </div></div></header>
  <div class="container main-container">{{ content | safe }}</div>
  <footer class="site-footer"><div class="container footer-content">
    <p>&copy; 2026 {{ site.author }}. All opinions are my own.</p>
    <p>Jewitch is powered by <a href="https://www.11ty.dev/">Eleventy</a>, <a href="https://pagescms.org/">Pages CMS</a>, Mastodon, and ActivityPub.</p>
    <p><span class="code-comment">Built with magic, anger, and an unreasonable amount of music.</span></p>
  </div></footer>
</body>
</html>
