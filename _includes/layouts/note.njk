---
layout: layouts/base.njk
---
<article class="single-post"><header class="post-header"><div class="post-meta"><time datetime="{{ mastodon_created_at }}">{{ date | readableDate }}</time></div><h1 class="post-title">{{ title }}</h1></header><div class="post-content">{{ content | safe }}</div><footer class="post-footer"><a href="/notes/" class="back-link">← Back to notes</a><div class="source-note">Originally published on Mastodon. <a href="{{ source_url }}" class="source-link">View the conversation</a></div></footer></article>
