{{!< default}}
{{#post}}
<article class="post-full">
  <header class="post-header">
    <div class="post-tags">{{tags prefix="#" separator=" &nbsp; #"}}</div>
    <h1>{{title}}</h1>
    {{#if custom_excerpt}}<p class="post-deck">{{custom_excerpt}}</p>{{/if}}
    <div class="post-meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time> <i></i> {{reading_time}}{{#primary_author}} <i></i> {{name}}{{/primary_author}}</div>
  </header>
  {{#if feature_image}}
    <figure class="feature-wrap"><img class="feature-image" src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>
  {{/if}}
  <div class="gh-content">{{content}}</div>
</article>
{{/post}}
