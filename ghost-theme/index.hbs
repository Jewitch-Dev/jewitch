{{!< default}}
<section class="hero">
  <div class="eyebrow">Jewitch · Personal Journal</div>
  <h1>Random brain droppings.</h1>
  <p>Writing, life, technology, religion, games, and whatever else escaped containment.</p>
  <div class="hero-orbit" aria-hidden="true"></div>
</section>
<section class="feed">
  <div class="section-label">Latest entries</div>
  {{#foreach posts}}
  <article class="post-card">
    {{#if feature_image}}<a class="post-thumb" href="{{url}}"><img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}"></a>{{/if}}
    <div class="post-card-copy">
      <div class="post-meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time> <i></i> {{reading_time}}</div>
      <h2><a href="{{url}}">{{title}}</a></h2>
      <p>{{excerpt words="36"}}</p>
      <div class="post-tags">{{tags prefix="#" separator=" &nbsp; #"}}</div>
    </div>
  </article>
  {{/foreach}}
  {{pagination}}
</section>
