{{!< default}}
<section class="hero">
  <div class="hero-copy">
    <div class="eyebrow"><span>SYS://</span> PERSONAL TRANSMISSION NODE</div>
    <h1>Random brain<br>droppings<span class="cursor">_</span></h1>
    <p>Writing, life, technology, religion, games, and whatever else escaped containment.</p>
    <div class="hero-readout"><span>NODE_ID // JEWITCH</span><span>MODE // UNFILTERED</span><span>SIGNAL // STABLE</span></div>
  </div>
  <div class="sigil-interface" aria-hidden="true">
    <div class="sigil-ring ring-one"></div><div class="sigil-ring ring-two"></div>
    <div class="sigil-cross"></div><span class="sigil-moon">☾</span><span class="sigil-star">✦</span>
    <span class="coord coord-a">34°//VOID</span><span class="coord coord-b">SIGIL_01</span>
  </div>
</section>
<section class="feed">
  <div class="section-bar"><span>TRANSMISSION_LOG</span><span>{{pagination.total}} ENTRIES // LATEST FIRST</span></div>
  {{#foreach posts}}
  <article class="post-card">
    {{#if feature_image}}<a class="post-thumb" href="{{url}}"><img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}"><span class="image-corner tl"></span><span class="image-corner br"></span></a>{{/if}}
    <div class="post-card-copy">
      <div class="post-meta"><span>ENTRY_{{@number}}</span><i></i><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY.MM.DD"}}</time><i></i>{{reading_time}}</div>
      <h2><a href="{{url}}">{{title}}</a></h2>
      <p>{{excerpt words="36"}}</p>
      <div class="post-tags">{{tags prefix="// " separator=" &nbsp; // "}}</div>
      <a class="read-link" href="{{url}}">OPEN TRANSMISSION <span>→</span></a>
    </div>
  </article>
  {{/foreach}}
  {{pagination}}
</section>
